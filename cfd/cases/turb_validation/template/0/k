FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

// freestream turbulence intensity 0.5 percent, U = 1
internalField   uniform 5e-05;

boundaryField
{
    wing
    {
        type            kqRWallFunction;
        value           uniform 5e-05;
    }
    farfield
    {
        type            inletOutlet;
        inletValue      uniform 5e-05;
        value           uniform 5e-05;
    }
    frontAndBack
    {
        type            empty;
    }
}

