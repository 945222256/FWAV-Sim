FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     pimpleFoam;

startFrom       latestTime;

stopAt          endTime;

// 12 convective times c/U (U = 1, c = 1); mean window [8, 12] spans about
// one shedding period at the cruise-range Reynolds numbers
endTime         12;

deltaT          0.002;

writeControl    adjustableRunTime;

writeInterval   2;

purgeWrite      1;

nWrite          0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           0.5;

maxDeltaT      0.01;

functions
{
    forces
    {
        type            forces;
        libs            ("libforces.so");
        patches         (wing);
        rho             rhoInf;
        rhoInf          1;
        CofR            (0 0 0);
        writeControl    timeStep;
        writeInterval   1;
        log             yes;
    }
}

