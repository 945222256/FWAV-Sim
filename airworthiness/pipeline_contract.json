      "formula_source": "平移李雅普诺夫格拉姆 + 逐模态可控强度（待背书）"
    },
    "S5_margins": {
      "tool": "airworthiness.steps.step5_margins",
      "inputs": [
        "A",
        "B",
        "C",
        "actuation_params",
        "participation"
      ],
      "outputs": [
        "modal_damping",
        "simo_margins",
        "stabilizing_gains",
        "retdiff_sigma_min"
      ],
      "thresholds": {
        "freq_grid": "0.01~100 Hz 对数一千点"
      },
      "formula_source": "经典增益相位裕度（回路符号归一）+ 稳定化增益扫描 + 频域最小奇异值（方阵回差/非方阵回路）（待背书）"
    },
    "S6_floquet": {
