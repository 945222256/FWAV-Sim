        "config_overrides"
      ],
      "outputs": [
        "x_trim",
        "freq_hz",
        "wz_coordinated",
        "residual_norm",
        "saturated"
      ],
      "thresholds": {
        "residual_norm_max": 1e-06,
        "sail_sat_abs": 0.295
      },
      "formula_source": "I-102 commit 8a63308"
    },
    "S2_linearize": {
      "tool": "airworthiness.steps.step2_linearize",
      "reuse": "ltv/hss_i102_stab.py open_loop_A（A 部分）；B 列同款中心差分新增",
      "inputs": [
        "x_trim",
        "freq_hz",
        "wz_coordinated"
      ],
      "outputs": [
        "A",
        "B",
        "state_names",
        "input_names",
        "trim_state",
        "scope_idx"
      ],
      "thresholds": {
        "fd_eps": 1e-05,
        "regression_tol_vs_i102": 1e-09
      },
      "formula_source": "I-102 commit 8a63308 + B 列偏导定义（待背书）"
    },
    "S3_modes": {
      "tool": "airworthiness.steps.step3_modes",
