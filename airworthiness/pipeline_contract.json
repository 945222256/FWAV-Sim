      ],
      "outputs": [
        "eigenvalues",
        "participation",
        "mode_tags",
        "condition_hint"
      ],
      "thresholds": {
        "participation_col_sum_tol": 1e-09,
        "weakly_damped_re": -1.0
      },
      "formula_source": "特征值清单 I-102；参与因子 w_li*v_ji 归一（待背书）"
    },
    "S4_gramians": {
      "tool": "airworthiness.steps.step4_gramians",
      "inputs": [
        "A",
        "B",
        "C",
        "scope_idx"
      ],
      "outputs": [
        "ctrb_rank",
        "obsv_rank",
        "Wc",
        "Wo",
        "Wc_sigma_min",
        "Wo_sigma_min",
        "shift",
        "modal_controllability",
        "lyap_residuals"
      ],
      "thresholds": {
        "lyap_rel_residual_max": 1e-08,
        "shift_rule": "max(0, max_eig_re) + 0.5"
