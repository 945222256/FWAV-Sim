        "x_trim",
        "freq_hz",
        "n_phi"
      ],
      "outputs": [
        "Ac",
        "As",
        "max_mu",
        "max_re_per_s",
        "reading"
      ],
      "thresholds": {
        "n_phi_default": 24,
        "stable_mu": 0.999
      },
      "formula_source": "I-079 commit 7d105ac"
    },
    "S7_report": {
      "tool": "airworthiness.steps.step7_report",
      "inputs": [
        "S1..S6 全部输出",
        "config_fingerprint",
        "run_info"
      ],
      "outputs": [
        "report.md",
        "verdict.json"
      ],
      "template_sections": [
        "头部",
        "配平",
        "线性化与模态",
        "可控性可观性",
        "稳定裕度",
        "周期口径",
        "三问结论"
