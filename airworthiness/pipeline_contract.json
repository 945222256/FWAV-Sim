  "entrypoint": "python airworthiness/pipeline.py --bank <deg> --scope <lateral|longitudinal|full>",
  "steps": {
    "S1_trim": {
      "tool": "airworthiness.steps.step1_trim",
      "reuse": "ltv/hss_i102_stab.py plant_trim",
